{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"build": {
			"color": "#C4876D"
		},
		"plan": {
			"color": "#8FA98A",
			"permission": {
				"edit": "deny"
			}
		}
	},
	"formatter": true,
	"permission": {
		"bash": {
			"*": "ask",
			"brew list *": "allow",
			"bun pm ls *": "allow",
			"bun run build *": "allow",
			"bun run lint *": "allow",
			"bun run typecheck *": "allow",
			"cat *": "allow",
			"date": "allow",
			"date *": "allow",
			"df": "allow",
			"df *": "allow",
			"diff *": "allow",
			"du *": "allow",
			"env": "allow",
			"env *": "allow",
			"file *": "allow",
			"find *": "allow",
			"git diff *": "allow",
			"git log *": "allow",
			"git show *": "allow",
			"git status *": "allow",
			"grep *": "allow",
			"head *": "allow",
			"ls": "allow",
			"ls *": "allow",
			"npm list *": "allow",
			"npm run build *": "allow",
			"npm run lint *": "allow",
			"npm run typecheck *": "allow",
			"pnpm list *": "allow",
			"pnpm outdated *": "allow",
			"pnpm run build *": "allow",
			"pnpm run format *": "allow",
			"pnpm run lint *": "allow",
			"pnpm run typecheck *": "allow",
			"pnpm view *": "allow",
			"pnpm why *": "allow",
			"pwd": "allow",
			"pwd *": "allow",
			"rg *": "allow",
			"sips *": "allow",
			"tail *": "allow",
			"tree *": "allow",
			"uname": "allow",
			"uname *": "allow",
			"wc *": "allow",
			"which *": "allow",
			"whoami": "allow",
			"whoami *": "allow"
		},
		"edit": "ask",
		"external_directory": "allow"
	},
	"lsp": true
}
