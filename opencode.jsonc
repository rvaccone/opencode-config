{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"build": {
			"color": "#C4876D"
		},
		"plan": {
			"color": "#8FA98A",
			"permission": {
				"edit": "deny"
			}
		}
	},
	"autoupdate": true,
	"command": {
		"commit": {
			"description": "Generate a commit message from staged changes and commit",
			"model": "opencode/deepseek-v4-flash-free",
			"template": "Analyze the following staged git diff and generate a concise, descriptive commit message in plain English that accurately summarizes the changes.\n\nStaged changes:\n!`git diff --staged`\n\nProvide only the commit message text (without quotes). Then run `git commit -m \"<generated message>\"` followed by `git push` to push the changes."
		}
	},
	"formatter": true,
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "{file:~/.local/share/opencode/secrets/context7.key}"
			}
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app"
		}
	},
	"model": "opencode-go/kimi-k2.6",
	"permission": {
		"bash": {
			"*": "ask",
			"brew list *": "allow",
			"bun pm ls *": "allow",
			"bun run build *": "allow",
			"bun run lint *": "allow",
			"bun run typecheck *": "allow",
			"cat *": "allow",
			"date *": "allow",
			"df *": "allow",
			"diff *": "allow",
			"du *": "allow",
			"env *": "allow",
			"file *": "allow",
			"find *": "allow",
			"git diff *": "allow",
			"git log *": "allow",
			"git show *": "allow",
			"git status *": "allow",
			"glob *": "allow",
			"grep *": "allow",
			"head *": "allow",
			"ls *": "allow",
			"npm list *": "allow",
			"npm run build *": "allow",
			"npm run lint *": "allow",
			"npm run typecheck *": "allow",
			"pnpm list *": "allow",
			"pnpm outdated *": "allow",
			"pnpm run build *": "allow",
			"pnpm run format *": "allow",
			"pnpm run lint *": "allow",
			"pnpm run typecheck *": "allow",
			"pnpm view *": "allow",
			"pnpm why *": "allow",
			"pwd *": "allow",
			"rg *": "allow",
			"sips *": "allow",
			"tail *": "allow",
			"tree *": "allow",
			"uname *": "allow",
			"wc *": "allow",
			"which *": "allow",
			"whoami *": "allow"
		},
		"edit": "ask",
		"external_directory": "allow"
	},
	"lsp": true
}
